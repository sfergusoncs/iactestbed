trigger: none

parameters:
  - name: environment
    displayName: 'Environment'
    type: string
    default: 'dev'
    values:
      - dev
      - uat
      - staging
      - prod
      - sandbox

    
  - name: deployVnet
    displayName: 'Deploy VNet'
    type: boolean
    default: 'true'
  - name: deployACR
    displayName: 'Deploy ACR'
    type: boolean
    default: 'true'
  - name: deployRedis
    displayName: 'Deploy Redis'
    type: boolean
    default: 'true'
  - name: deployAKS
    displayName: 'Deploy AKS'
    type: boolean
    default: 'true'
  - name: deployBlobCache
    displayName: 'Deploy Blob Cache'
    type: boolean
    default: 'true'
  - name: deployBlobPerm
    displayName: 'Deploy Blob Perm'
    type: boolean
    default: 'true'

  - name: subscriptionId
    displayName: 'Target Subscription ID'
    type: string
    default: ''

  - name: hubSubscriptionId
    displayName: 'Hub Subscription ID'
    type: string
    default: 'c290fb32-8a22-4aeb-9147-d6d4e54071dd' 

pool:
  vmImage: ubuntu-latest
  name: default

variables:
  serviceConnection: 'sandman-sc-${{ parameters.environment }}'
  hubServiceConnection: 'sandman-sc-hub'
  location: 'southcentralus'
  resourceGroup: 'sandman-rg-${{ parameters.environment }}'
  parametersPath: 'infrastructure/parameters/${{ parameters.environment }}'
  vnetName: 'sandman-vnet-${{ parameters.environment }}'
  MSYS_NO_PATHCONV: 1
  MSYS2_ARG_CONV_EXCL: '*'

stages:
  - stage: Deploy
    displayName: 'Deploy ${{ parameters.environment }} Environment'
    jobs:
      - job: DeployInfrastructure
        steps:
          
          # Create Resource Group
          - task: AzureCLI@2
            displayName: 'Create Resource Group'
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                az group create \
                  --subscription ${{ parameters.subscriptionId }} \
                  --name $(resourceGroup) \
                  --location $(location)

          

             
          # Create Key Vault
          - task: AzureCLI@2
            displayName: 'Create Keyvault'
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                az keyvault create \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name sandman-kv-${{ parameters.environment }} \
                  --location $(location) \
                  --enable-rbac-authorization true \
                  --public-network-access disabled \
                  --tags app=sandman \
                  --retention-days 7 || echo "keyvault already exists, skipping"

              #Create Routetable    
          - task: AzureCLI@2
            displayName: 'Deploy Route Table'
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                az deployment group create \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --template-file infrastructure/modules/routetable.bicep \
                  --parameters $(parametersPath)/routetable.params.json \
                  --parameters routeTableName=sandman-rt-${{ parameters.environment }} \
                  --parameters tags="{'app':'sandman','environment':'${{ parameters.environment }}'}"

          # Deploy VNet
          - task: AzureCLI@2
            displayName: 'Deploy VNet'
            condition: and(succeeded(), eq('${{ parameters.deployVnet }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                az deployment group create \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --template-file infrastructure/modules/vnet.bicep \
                  --parameters $(parametersPath)/vnet.params.json \
                  --parameters environment=${{ parameters.environment }} \
                  --parameters location=$(location)

          # Peer Hub to Spoke
          - task: AzureCLI@2
            displayName: 'Peer Hub to Spoke'
            inputs:
              azureSubscription: $(hubServiceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                echo "Remote VNet: /subscriptions/${{ parameters.subscriptionId }}/resourceGroups/sandman-rg-${{ parameters.environment }}/providers/Microsoft.Network/virtualNetworks/sandman-vnet-${{ parameters.environment }}"

                az network vnet peering create \
                  --name sandman-peer-to-${{ parameters.environment }} \
                  --resource-group sandman-rg-hub \
                  --vnet-name sandman-vnet-hub \
                  --remote-vnet "/subscriptions/${{ parameters.subscriptionId }}/resourceGroups/sandman-rg-${{ parameters.environment }}/providers/Microsoft.Network/virtualNetworks/sandman-vnet-${{ parameters.environment }}" \
                  --allow-vnet-access true \
                  --allow-forwarded-traffic true || echo "Peering already exists, skipping"

          # Deploy ACR
          - task: AzureCLI@2
            displayName: 'Deploy ACR'
            condition: and(succeeded(), eq('${{ parameters.deployACR }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                existing=$(az acr show \
                --subscription ${{ parameters.subscriptionId }} \
                --resource-group $(resourceGroup) \
                --name sandmanacr${{ parameters.environment }} \
                --query 'name' \
                --output tsv 2>/dev/null)

                if [ -n "$existing" ]; then
                  echo "ACR already exists, skipping deployment"
                else  
                  peSubnetId=$(az network vnet subnet show \
                    --subscription ${{ parameters.subscriptionId }} \
                    --resource-group $(resourceGroup) \
                    --vnet-name $(vnetName) \
                    --name sandman-snet-pe \
                    --query 'id' \
                    --output tsv)

                  vnetId=$(az network vnet show \
                    --subscription ${{ parameters.subscriptionId }} \
                    --resource-group $(resourceGroup) \
                    --name $(vnetName) \
                    --query 'id' \
                    --output tsv)

                  az deployment group create \
                    --subscription ${{ parameters.subscriptionId }} \
                    --resource-group $(resourceGroup) \
                    --template-file infrastructure/modules/acr.bicep \
                    --parameters $(parametersPath)/acr.params.json \
                    --parameters environment=${{ parameters.environment }} \
                    --parameters location=$(location) \
                    --parameters subnetId="$peSubnetId" \
                    --parameters vnetId="$vnetId"
                fi

          # Deploy Blob Cache Storage
          - task: AzureCLI@2
            displayName: 'Deploy Blob Cache Storage'
            condition: and(succeeded(), eq('${{ parameters.deployBlobCache }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                existing=$(az storage account show \
                --subscription ${{ parameters.subscriptionId }} \
                --resource-group $(resourceGroup) \
                --name sandmanblobcache${{ parameters.environment }} \
                --query 'name' \
                --output tsv 2>/dev/null)

                if [ -n "$existing" ]; then
                  echo "blob cache already exists, skipping deployment"
                else                
                peSubnetId=$(az network vnet subnet show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --vnet-name $(vnetName) \
                  --name sandman-snet-pe \
                  --query 'id' \
                  --output tsv)

                vnetId=$(az network vnet show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name $(vnetName) \
                  --query 'id' \
                  --output tsv)

                az deployment group create \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --template-file infrastructure/modules/blobcache.bicep \
                  --parameters $(parametersPath)/blobcache.params.json \
                  --parameters environment=${{ parameters.environment }} \
                  --parameters location=$(location) \
                  --parameters subnetId="$peSubnetId" \
                  --parameters vnetId="$vnetId"
                fi

          # Create RSV Resource Group (prod only)
          - task: AzureCLI@2
            displayName: 'Create RSV Resource Group'
            condition: eq('${{ parameters.environment }}', 'prod')
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                az group create \
                  --subscription ${{ parameters.subscriptionId }} \
                  --name sandman-rg-rsv-${{ parameters.environment }} \
                  --location $(location)

          # Deploy Blob Perm Storage
          - task: AzureCLI@2
            displayName: 'Deploy Blob Perm Storage'
            condition: and(succeeded(), eq('${{ parameters.deployBlobPerm }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                existing=$(az storage account show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name sandmanperm${{ parameters.environment }} \
                  --query 'name' \
                  --output tsv 2>/dev/null)

                if [ -n "$existing" ]; then
                  echo "blob perm already exists, skipping deployment"
                else               
                peSubnetId=$(az network vnet subnet show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --vnet-name $(vnetName) \
                  --name sandman-snet-pe \
                  --query 'id' \
                  --output tsv)

                vnetId=$(az network vnet show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name $(vnetName) \
                  --query 'id' \
                  --output tsv)

                az deployment group create \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --template-file infrastructure/modules/blobperm.bicep \
                  --parameters $(parametersPath)/blobperm.params.json \
                  --parameters environment=${{ parameters.environment }} \
                  --parameters location=$(location) \
                  --parameters subnetId="$peSubnetId" \
                  --parameters vnetId="$vnetId"
                  fi

              # Deploy REDIS
          - task: AzureCLI@2
            displayName: 'Deploy redis'
            condition: and(succeeded(), eq('${{ parameters.deployRedis }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                existing=$(az redisenterprise show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name sandman-redis-${{ parameters.environment }} \
                  --query 'name' \
                  --output tsv 2>/dev/null)

                if [ -n "$existing" ]; then
                  echo "redis already exists, skipping deployment"
                else               
                peSubnetId=$(az network vnet subnet show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --vnet-name $(vnetName) \
                  --name sandman-snet-pe \
                  --query 'id' \
                  --output tsv)

                vnetId=$(az network vnet show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name $(vnetName) \
                  --query 'id' \
                  --output tsv)

                az deployment group create \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --template-file infrastructure/modules/redis.bicep \
                  --parameters $(parametersPath)/redis.params.json \
                  --parameters environment=${{ parameters.environment }} \
                  --parameters location=$(location) \
                  --parameters subnetId="$peSubnetId" \
                  --parameters vnetId="$vnetId"
                fi
              # Deploy AKS
          - task: AzureCLI@2
            displayName: 'Deploy AKS'
            condition: and(succeeded(), eq('${{ parameters.deployAKS }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                aksSubnetId=$(az network vnet subnet show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --vnet-name $(vnetName) \
                  --name sandman-snet-aks \
                  --query 'id' \
                  --output tsv)

                vnetId=$(az network vnet show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name $(vnetName) \
                  --query 'id' \
                  --output tsv)

                acrId=$(az acr show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name sandmanacr${{ parameters.environment }} \
                  --query 'id' \
                  --output tsv)

                az deployment group create \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --template-file infrastructure/modules/aks.bicep \
                  --parameters $(parametersPath)/aks.params.json \
                  --parameters environment=${{ parameters.environment }} \
                  --parameters location=$(location) \
                  --parameters aksSubnetId="$aksSubnetId" \
                  --parameters acrId="$acrId"

              # Assign Network Contributor to AKS UAMI
          - task: AzureCLI@2
            displayName: 'Assign Network Contributor to AKS UAMI'
            condition: and(succeeded(), eq('${{ parameters.deployAKS }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                uamiPrincipalId=$(az identity show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name sandman-uami-aks-${{ parameters.environment }} \
                  --query 'principalId' \
                  --output tsv)

                vnetId=$(az network vnet show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name $(vnetName) \
                  --query 'id' \
                  --output tsv)

                az role assignment create \
                  --assignee $uamiPrincipalId \
                  --role 'Network Contributor' \
                  --scope $vnetId \
                  --subscription ${{ parameters.subscriptionId }} || echo "Role assignment already exists, skipping"

              # Attach ACR to AKS
          - task: AzureCLI@2
            displayName: 'Attach ACR to AKS'
            condition: and(succeeded(), eq('${{ parameters.deployAKS }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                az aks update \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name sandman-aks-${{ parameters.environment }} \
                  --attach-acr sandmanacr${{ parameters.environment }}

          - task: AzureCLI@2
            displayName: 'Assign AKS Admin Role to CSOL_Server_admin'
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                GROUP_ID=$(az ad group show --group "CSOL_Server_admin" --query id -o tsv)
                
                az role assignment create \
                  --role "Azure Kubernetes Service RBAC Cluster Admin" \
                  --assignee-object-id $GROUP_ID \
                  --assignee-principal-type Group \
                  --scope /subscriptions/${{ parameters.subscriptionId }}/resourceGroups/$(resourceGroup)/providers/Microsoft.ContainerService/managedClusters/sandman-aks-${{ parameters.environment }}

           # Assign AcrPush to service connection SP
          - task: AzureCLI@2
            displayName: 'Assign AcrPush to Service Connection SP'
            condition: and(succeeded(), eq('${{ parameters.deployACR }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                SP_OBJECT_ID=$(az ad sp show \
                  --id $(az account show --query user.name -o tsv) \
                  --query id -o tsv)

                ACR_ID=$(az acr show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name sandmanacr${{ parameters.environment }} \
                  --query 'id' \
                  --output tsv)

                az role assignment create \
                  --role "AcrPush" \
                  --assignee-object-id $SP_OBJECT_ID \
                  --assignee-principal-type ServicePrincipal \
                  --scope $ACR_ID \
                  --subscription ${{ parameters.subscriptionId }} || echo "Role assignment already exists, skipping"

          # Assign AKS RBAC Cluster Admin to service connection SP
          - task: AzureCLI@2
            displayName: 'Assign AKS RBAC Cluster Admin to Service Connection SP'
            condition: and(succeeded(), eq('${{ parameters.deployAKS }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                SP_OBJECT_ID=$(az ad sp show \
                  --id $(az account show --query user.name -o tsv) \
                  --query id -o tsv)

                az role assignment create \
                  --role "Azure Kubernetes Service RBAC Cluster Admin" \
                  --assignee-object-id $SP_OBJECT_ID \
                  --assignee-principal-type ServicePrincipal \
                  --scope /subscriptions/${{ parameters.subscriptionId }}/resourceGroups/$(resourceGroup)/providers/Microsoft.ContainerService/managedClusters/sandman-aks-${{ parameters.environment }} \
                  --subscription ${{ parameters.subscriptionId }} || echo "Role assignment already exists, skipping"       

          # Get Kubelet Identity Client ID
          - task: AzureCLI@2
            displayName: 'Get Kubelet Identity Client ID'
            condition: and(succeeded(), eq('${{ parameters.deployAKS }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                kubeletClientId=$(az aks show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name sandman-aks-${{ parameters.environment }} \
                  --query "identityProfile.kubeletidentity.clientId" \
                  --output tsv)

                kubeletPrincipalId=$(az aks show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name sandman-aks-${{ parameters.environment }} \
                  --query "identityProfile.kubeletidentity.objectId" \
                  --output tsv)

                echo "##vso[task.setvariable variable=kubeletClientId;isOutput=true]$kubeletClientId"
                echo "##vso[task.setvariable variable=kubeletPrincipalId;isOutput=true]$kubeletPrincipalId"
            name: getKubeletIdentity

          # Grant App Config Data Reader to Kubelet Identity (cross-subscription)
          - task: AzureCLI@2
            displayName: 'Grant App Config Data Reader to Kubelet Identity'
            condition: and(succeeded(), eq('${{ parameters.deployAKS }}', true))
            inputs:
              azureSubscription: $(hubServiceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                az role assignment create \
                  --assignee-object-id $(getKubeletIdentity.kubeletPrincipalId) \
                  --assignee-principal-type ServicePrincipal \
                  --role "App Configuration Data Reader" \
                  --scope /subscriptions/${{ parameters.hubSubscriptionId }}/resourceGroups/sandman-rg-hub/providers/Microsoft.AppConfiguration/configurationStores/sandman-Appconfig-hub \
                  || echo "Role assignment already exists, skipping"

          # Install App Configuration Provider
          - task: AzureCLI@2
            displayName: 'Install App Configuration Provider'
            condition: and(succeeded(), eq('${{ parameters.deployAKS }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                az aks get-credentials \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name sandman-aks-${{ parameters.environment }} \
                  --overwrite-existing

                helm repo add azure-app-configuration \
                  https://azure.github.io/AppConfiguration-KubernetesProvider/helm
                helm repo update
                helm upgrade --install azureappconfiguration.kubernetesprovider \
                  azure-app-configuration/kubernetes-provider \
                  --namespace azappconfig-system \
                  --create-namespace

          # Deploy AzureAppConfigurationProvider resource
          - task: AzureCLI@2
            displayName: 'Deploy App Config Provider Resource'
            condition: and(succeeded(), eq('${{ parameters.deployAKS }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                kubectl apply -f - <<EOF
                apiVersion: azconfig.io/v1
                kind: AzureAppConfigurationProvider
                metadata:
                  name: sandman-appconfig
                  namespace: sandman
                spec:
                  endpoint: https://sandman-Appconfig-hub.azconfig.io
                  auth:
                    managedIdentityClientId: "$(getKubeletIdentity.kubeletClientId)"
                  configuration:
                    selectors:
                      - keyFilter: "sandman-frontend/runtime-config"
                        labelFilter: "${{ parameters.environment }}"
                    trimKeyPrefixes:
                      - "sandman-frontend/"
                  target:
                    configMapName: runtime-config-frontend
                EOF

          # Deploy Frontend Helm Chart
          - task: AzureCLI@2
            displayName: 'Deploy Frontend Helm Chart'
            condition: and(succeeded(), eq('${{ parameters.deployAKS }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                helm upgrade --install sandman-frontend \
                  ./charts/sandman-frontend \
                  -f ./charts/sandman-frontend/values.yaml \
                  -f ./charts/sandman-frontend/values-${{ parameters.environment }}.yaml \
                  --namespace sandman \
                  --create-namespace

          # Wait for Load Balancer IP
          - task: AzureCLI@2
            displayName: 'Wait for Load Balancer IP'
            condition: and(succeeded(), eq('${{ parameters.deployAKS }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                echo "Waiting for Load Balancer IP..."
                for i in {1..20}; do
                  lbIp=$(kubectl get service sandman-frontend-sandbox-svc \
                    --namespace sandman \
                    --output jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null)
                  if [ -n "$lbIp" ]; then
                    echo "Load Balancer IP: $lbIp"
                    echo "##vso[task.setvariable variable=lbIp;isOutput=true]$lbIp"
                    break
                  fi
                  echo "Attempt $i/20 — waiting 15s..."
                  sleep 15
                done
                if [ -z "$lbIp" ]; then
                  echo "##vso[task.logissue type=error]Timed out waiting for Load Balancer IP"
                  exit 1
                fi
            name: waitForLb

          # Create Private Link Service
          - task: AzureCLI@2
            displayName: 'Create Private Link Service'
            condition: and(succeeded(), eq('${{ parameters.deployAKS }}', true))
            inputs:
              azureSubscription: $(serviceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                aksSubnetId=$(az network vnet subnet show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --vnet-name $(vnetName) \
                  --name sandman-snet-aks \
                  --query 'id' \
                  --output tsv)

                lbFrontendId=$(az network lb frontend-ip list \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group MC_$(resourceGroup)_sandman-aks-${{ parameters.environment }}_$(location) \
                  --lb-name kubernetes-internal \
                  --query "[?privateIPAddress=='$(waitForLb.lbIp)'].id" \
                  --output tsv)

                az network private-link-service create \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name sandman-pls-frontend-${{ parameters.environment }} \
                  --vnet-name $(vnetName) \
                  --subnet sandman-snet-aks \
                  --lb-frontend-ip-configs $lbFrontendId \
                  --location $(location) \
                  || echo "Private Link Service already exists, skipping"

                plsId=$(az network private-link-service show \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name sandman-pls-frontend-${{ parameters.environment }} \
                  --query 'id' \
                  --output tsv)

                echo "##vso[task.setvariable variable=plsId;isOutput=true]$plsId"
            name: createPls

          # Configure Front Door Origin
          - task: AzureCLI@2
            displayName: 'Configure Front Door Origin'
            condition: and(succeeded(), eq('${{ parameters.deployAKS }}', true))
            inputs:
              azureSubscription: $(hubServiceConnection)
              scriptType: 'bash'
              scriptLocation: 'inlineScript'
              inlineScript: |
                az afd origin create \
                  --subscription ${{ parameters.hubSubscriptionId }} \
                  --resource-group sandman-rg-hub \
                  --profile-name sandman-afd-hub \
                  --origin-group-name sandman-frontend-${{ parameters.environment }} \
                  --origin-name sandman-frontend-${{ parameters.environment }} \
                  --host-name sandman-${{ parameters.environment }}.chalksolutions.com \
                  --origin-host-header sandman-${{ parameters.environment }}.chalksolutions.com \
                  --http-port 30440 \
                  --https-port 443 \
                  --priority 1 \
                  --weight 1000 \
                  --enable-private-link true \
                  --private-link-resource $(createPls.plsId) \
                  --private-link-location $(location) \
                  --private-link-request-message "AFD origin for sandman-${{ parameters.environment }}" \
                  || echo "Origin already exists, skipping"

                # Approve the private link connection
                sleep 30
                connectionId=$(az network private-link-service list-connections \
                  --subscription ${{ parameters.subscriptionId }} \
                  --resource-group $(resourceGroup) \
                  --name sandman-pls-frontend-${{ parameters.environment }} \
                  --query "[?properties.privateLinkServiceConnectionState.status=='Pending'].name" \
                  --output tsv)

                if [ -n "$connectionId" ]; then
                  az network private-link-service connection update \
                    --subscription ${{ parameters.subscriptionId }} \
                    --resource-group $(resourceGroup) \
                    --service-name sandman-pls-frontend-${{ parameters.environment }} \
                    --name $connectionId \
                    --connection-status Approved
                fi

          # Reminders
          - task: Bash@3
            displayName: 'Post-Deploy Reminders'
            inputs:
              targetType: 'inline'
              script: |
                echo "##vso[task.logissue type=warning]MANUAL: Peer OG prod VNet to sandman-vnet-${{ parameters.environment }} if not already done"
                echo "##vso[task.logissue type=warning]MANUAL: Link private DNS zones to OG prod VNet if not already done"        